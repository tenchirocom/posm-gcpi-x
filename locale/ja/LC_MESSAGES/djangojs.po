#: app/src/components/ControlPoints.js
msgid "Ground Control Point Interface"
msgstr "地上基準点インターフェース"

#: app/src/components/ControlPoints.js
msgid "Ground Control Points"
msgstr "地上基準点"

#: app/src/components/ControlPoints.js
msgid "No points..."
msgstr "ポイントがありません..."

#: app/src/components/Directions.js
msgid "Directions"
msgstr "手順"

#: app/src/components/Directions.js
msgid "Connect at least 5 high-contrast objects in 3 or more photos to their corresponding locations on the map."
msgstr "3枚以上の写真にある、コントラストのはっきりした5つ以上のオブジェクトを、地図上の対応する位置に関連付けます。"

#: app/src/components/Directions.js
msgid "Upload images (jpeg or png)."
msgstr "画像をアップロードしてください (jpeg または png)。"

#: app/src/components/Directions.js
msgid "Set a point in an image."
msgstr "画像上にポイントを設定します。"

#: app/src/components/Directions.js
msgid "Set a corresponding point on the map."
msgstr "地図上に対応するポイントを設定します。"

#: app/src/components/Directions.js
msgid "Repeat as desired (at least until the goal is achieved)."
msgstr "必要に応じて繰り返します（少なくとも目標が達成されるまで）。"

#: app/src/components/Directions.js
msgid "Generate the ground control point file."
msgstr "地上基準点ファイルを生成します。"

#: app/src/components/ImageGetter.js
msgid "Load existing Control Point File"
msgstr "既存の地上基準点ファイルを読み込む"

#: app/src/components/ImageGetter.js
msgid "Choose images"
msgstr "画像を選択"

#: app/src/components/ImageGetter.js
msgid "drag here"
msgstr "ここにドラッグ"

#: app/src/components/ExportButton.js
msgid "Export file"
msgstr "ファイルをエクスポート"

#: app/src/components/ExportModal.js
msgid "Ground control point file"
msgstr "地上基準点ファイル"

#: app/src/components/Image.js
msgid "selected"
msgstr "選択済み"

#: app/src/components/ExportModal.js
msgid "Sorry copy is not working, please use Ctrl/Cmd+C to copy"
msgstr "申し訳ありませんが、コピー機能が動作しないため、Ctrl/Cmd+C キーを使用してコピーしてください"

#: app/src/components/ExportModal.js
msgid "Invalid coordinate reference system. Please enter a valid <a href=\"http://proj4.org/\">proj.4</a> string."
msgstr "無効な座標参照系です。有効な <a href=\"http://proj4.org/\">proj.4</a> 文字列を入力してください。"

#: app/src/components/ExportModal.js
msgid "Save"
msgstr "保存"

#: app/src/components/ExportModal.js
msgid "Copy"
msgstr "コピー"

#: app/src/components/FilePreview.js
msgid "Ground control point file preview"
msgstr "地上基準点ファイルのプレビュー"

#: app/src/components/FilePreview.js
msgid "Cancel"
msgstr "キャンセル"

#: app/src/components/ExportModal.js
msgid "Copy text with %(shortcut)s or"
msgstr "%(shortcut)s または"

#: app/src/state/utils/controlpoints.js
msgid "There are no ground control points to export."
msgstr "エクスポートする地上基準点がありません。"

#: app/src/state/utils/controlpoints.js
msgid "A ground control point file should have a minimum of 15 points. There needs to be 5 control objects and each control object must have 3 image points referenced. Please see this %(articleLink)s for more information."
msgstr "地上基準点ファイルには、最低15個のポイントが必要です。5つのコントロールオブジェクトが必要であり、各コントロールオブジェクトには3つの画像ポイントが参照されている必要があります。詳細については、こちらの%(articleLink)sをご覧ください。"

#: app/src/state/utils/controlpoints.js
msgid "It's recommended to have at least 10 image points."
msgstr "画像ポイントは10個以上持つことが推奨されます。"

#: app/src/state/utils/controlpoints.js
msgid "Seems you have enough image points but not enough control objects. There should be at least 5."
msgstr "画像ポイントは足りているようですが、コントロールオブジェクトが不足しています。少なくとも5つ必要です。"

#: app/src/state/utils/controlpoints.js
msgid "There should be at least 5 control points that have image points referenced."
msgstr "画像ポイントが参照されているコントロールオブジェクトが少なくとも5つ必要です。"

#: app/src/state/utils/controlpoints.js
msgid "Control objects should have at least 3 image points referenced."
msgstr "各コントロールオブジェクトには、少なくとも3つの画像ポイントが参照されている必要があります。"

#: app/src/components/FilePreview.js
msgid "Load"
msgstr "読み込み"

#: app/src/components/ImagesGetter.js
msgid "GCP file loaded"
msgstr "GCP ファイルを読み込みました"

#: app/src/components/ImagePanZoom.js
#: app/src/components/PointMarkersMap.js
msgid "Delete"
msgstr "削除"

#: app/src/components/ImagePanZoom.js
msgid "Deselect"
msgstr "選択解除"

#: app/src/components/Leaflet-Search.js
msgid "Search..."
msgstr "検索..."

#: app/src/components/ControlPoints.js
#: app/src/components/LeafletMap-Providers-Control.js
msgid "Map Provider"
msgstr "マッププロバイダ"

#: app/src/components/ControlPoints.js
msgid "OpenStreetMap"
msgstr "OpenStreetMap"

#: app/src/components/ControlPoints.js
msgid "Satellite"
msgstr "衛星画像"

#: app/src/components/Leaflet-Zoomcontrols.js
msgid "Zoom in"
msgstr "拡大"

#: app/src/components/Leaflet-Zoomcontrols.js
msgid "Zoom out"
msgstr "縮小"

#: app/src/components/Leaflet-Zoomcontrols.js
msgid "Fit markers"
msgstr "マーカーに合わせる"

#: app/src/components/LeafletMap-Providers-Control.js
msgid "Custom"
msgstr "カスタム"

#: app/src/components/LeafletMap-Providers-Control.js
msgid "Enter a template string"
msgstr "テンプレート文字列を入力してください"

#: app/src/components/LeafletMap-Providers-Control.js
msgid "Enter"
msgstr "入力"

#: app/src/components/LeafletMap-Providers-Control.js
msgid "Apply"
msgstr "適用"

#: app/src/components/PointMarkersMap.js
msgid "Lock"
msgstr "ロック"

#: app/src/config.js
msgid "Enter template url..."
msgstr "テンプレートURLを入力..."

#: app/src/config.js
msgid "Enter a tile URL template. Valid tokens are {z}, {x}, {y}, for Z/X/Y scheme and {u} for quadtile scheme."
msgstr "タイルURLテンプレートを入力してください。有効なトークンは、Z/X/Yスキームの場合は {z}、{x}、{y}、クアッドタイルスキームの場合は {u} です。"


#: app/src/components/ControlPoints.js
msgid "Ground Control Point Interface"
msgstr "地上基準点インターフェース"

#: app/src/components/ControlPoints.js
msgid "Ground Control Points"
msgstr "地上基準点"

#: app/src/components/ControlPoints.js
msgid "No points..."
msgstr "ポイントがありません..."

#: app/src/components/ControlPoints.js
msgid "Directions"
msgstr "手順"

#: app/src/components/ControlPoints.js
msgid "Connect at least 5 high-contrast objects in 3 or more photos to their corresponding locations on the map."
msgstr "3枚以上の写真にある、コントラストのはっきりした5つ以上のオブジェクトを、地図上の対応する位置に関連付けます。"

#: app/src/components/ControlPoints.js
msgid "	Upload images (jpeg or png)."
msgstr "画像をアップロードしてください (jpeg または png)。"

#: app/src/components/ControlPoints.js
msgid "Set a point in an image."
msgstr "画像上にポイントを設定します。"

#: app/src/components/ControlPoints.js
msgid "Set a corresponding point on the map."
msgstr "地図上に対応するポイントを設定します。"

#: app/src/components/ControlPoints.js
msgid "Repeat as desired (at least until the goal is achieved)."
msgstr "必要に応じて繰り返します（少なくとも目標が達成されるまで）。"

#: app/src/components/ControlPoints.js
msgid "Generate the ground control point file."
msgstr "地上基準点ファイルを生成します。"

#: app/src/components/ControlPoints.js
msgid "Load existing Control Point File"
msgstr "既存の地上基準点ファイルを読み込む"

#: app/src/components/ControlPoints.js
msgid "Choose images / drag here"
msgstr "画像を選択 / ここにドラッグ"

#: app/src/components/ControlPoints.js
msgid "Export file"
msgstr "ファイルをエクスポート"

#: app/src/components/ControlPoints.js
msgid "Search..."
msgstr "検索..."

#: app/src/components/ControlPoints.js
msgid "Map Provider"
msgstr "マッププロバイダ"

#: app/src/components/ControlPoints.js
msgid "OpenStreetMap"
msgstr "OpenStreetMap"

#: app/src/components/ControlPoints.js
msgid "Satellite"
msgstr "衛星画像"

#: app/src/components/ControlPoints.js
msgid "Custom"
msgstr "カスタム"

#: app/src/components/ControlPoints.js
msgid "Zoom in"
msgstr "拡大"

#: app/src/components/ControlPoints.js
msgid "Zoom out"
msgstr "縮小"

#: app/src/components/ControlPoints.js
msgid "Fit markers..."
msgstr "マーカーに合わせる..."

